# Canonical site URL used for metadata, Open Graph, and the sitemap.
# Change this before production.
NEXT_PUBLIC_SITE_URL=https://www.autoworkspace.uk

# Transactional email for listing suggestions, reports, and claim requests.
# Resend is used from a server route. These three are required in production.
# In local development, submissions are validated and logged if they are unset.
RESEND_API_KEY=
DIRECTORY_INBOX_EMAIL=
DIRECTORY_FROM_EMAIL=AutoWorkspace UK <noreply@autoworkspace.uk>

# Optional production check that fails if required variables are missing:
# npm run check:env -- --production

# Optional but recommended for public launch. When both are set, submissions must
# include a Cloudflare Turnstile token and the widget appears on all forms.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
